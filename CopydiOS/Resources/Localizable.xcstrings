    "Full Access lets the keyboard read your Copyd history. Copyd never sends what you type anywhere." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access lets the keyboard read your Copyd history. Copyd never sends what you type anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso total permite que el teclado lea tu historial de Copyd. Copyd nunca envía lo que escribes a ningún lugar."
          }
        }
      }
    },
