    "This deletes %lld unpinned clips from history. Pinboard items stay available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán %lld clips sin fijar del historial. Los elementos de los tableros se conservan."
          }
